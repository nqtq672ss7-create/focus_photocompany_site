# ==============================================================================
# ФОКУС — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (ENVIRONMENT VARIABLES)
# Скопируйте этот файл в .env и укажите ваши реальные значения:
# cp .env.example .env
# ==============================================================================

# SMS-шлюз SMS.RU (для мгновенных SMS Екатерине на +7 929 850-85-03)
SMS_RU_API_KEY=

# Логин и пароль администратора для доступа к /leads_dashboard.html и /api/leads
FOCUS_ADMIN_USER=admin
FOCUS_ADMIN_PASS=ChangeThisSecurePasswordInProduction!

# Секретный статический токен (опционально, для API-интеграций CRM)
FOCUS_ADMIN_TOKEN=

# Уведомления в Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM Webhook (опционально)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Порт веб-сервера
PORT=8080
